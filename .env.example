# Contact Form Email Configuration
# Required for the "Start a Project" contact form to send emails

# Resend API Key (required)
# Get your API key from https://resend.com/api-keys
# The key should start with "re_"
RESEND_API_KEY=your_resend_api_key_here

# From Email (required)
# Must be a verified sender in your Resend account
# Format: "Name <email@example.com>" or just "email@example.com"
CONTACT_FROM_EMAIL=GROWW TECH <hello@groww.tech>

# To Email (optional)
# Recipient email for project inquiries
# Defaults to growwurself@gmail.com if not set
CONTACT_TO_EMAIL=growwurself@gmail.com
